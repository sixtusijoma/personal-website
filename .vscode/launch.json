{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug frontend (Chrome)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/frontend",
      "preLaunchTask": "frontend: dev",
      "postDebugTask": "frontend: stop"
    },
    {
      "name": "Debug backend",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "backend: build",
      "program": "${workspaceFolder}/backend/bin/Debug/net10.0/backend.dll",
      "cwd": "${workspaceFolder}/backend",
      "stopAtEntry": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5035"
      }
    }
  ],
  "compounds": [
    {
      "name": "Debug site",
      "configurations": ["Debug backend", "Debug frontend (Chrome)"],
      "stopAll": true
    }
  ]
}
